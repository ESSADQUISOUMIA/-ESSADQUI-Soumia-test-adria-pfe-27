enum AccountStatus {
    ACTIVE
    BLOCKED
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

type AccountPage {
    content: [Account!]!
    totalElements: Float!
    totalPages: Int!
    number: Int!
}

input CreateAccountInput {
    customerReference: String!
    currency: String!
    initialBalance: String!
}

type Query {
    account(id: ID!): Account!
    accounts(page: Int = 0, size: Int = 20): AccountPage!
}

type Mutation {
    createAccount(input: CreateAccountInput!): Account!
    changeAccountStatus(id: ID!, status: AccountStatus!): Account!
}