type BankTransaction { id:ID!, accountId:ID!, destinationAccountId:ID, amount:String!,currency:String!,merchantCategory:String!,country:String!,createdAt:String!,status:String! }
input Input {id:ID!,accountId:ID!,destinationAccountId:ID,amount:String!,currency:String!,merchantCategory:String!,country:String!}
type Query { transactions:[BankTransaction!]!,transaction(id:ID!):BankTransaction! }
type Mutation {createTransaction(input:Input!):BankTransaction!}
